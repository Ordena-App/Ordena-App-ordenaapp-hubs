# Puerto del servicio (gateway lo espera en 3013)
PORT=3013

# Mongo compartida de la plataforma
DB_LINK=mongodb://localhost:27017/ordena_app_nosql_db

# Secreto para los JWT de usuarios de hub (HUB_OWNER/HUB_ADMIN/HUB_STAFF/BUSINESS_VIEWER)
JWT_SECRET=hubs-service-secret

# Microservicios internos
BUSINESS_SERVICE_LINK=http://localhost:3002/api
ORDERS_SERVICE_LINK=http://localhost:3005/api
PRODUCTS_SERVICE_LINK=http://localhost:3004/api

# Secreto compartido para llamadas server-to-server hacia otros microservicios
INTERNAL_SHARED_SECRET=
